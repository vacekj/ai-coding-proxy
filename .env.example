# Optional server binding.
HOST=127.0.0.1
PORT=8317

# Grok Composer defaults. The proxy reads OAuth credentials from the Grok CLI.
GROK_PROXY_MODEL=grok-composer-2.5-fast
GROK_CLI_AUTH_FILE=~/.grok/auth.json

# Optional OpenCode settings. The Zen free tier (zen/*) needs no credentials;
# OpenCode Go (go/*) reads the `opencode-go` key written by `opencode auth login`.
# OPENCODE_API_KEY=
# OPENCODE_AUTH_FILE=~/.local/share/opencode/auth.json
# OPENCODE_PROXY_MODEL=zen/mimo-v2.5-free
# PROXY_PROVIDER=opencode

# Ox Alpha free preview. Both gateways serve the same upstream model.
# OPENROUTER_API_KEY=
# NOUS_API_KEY=
# PROXY_PROVIDER=hermes

# Optional request compaction knobs for huge tool results.
PROXY_MAX_TOOL_RESULT_CHARS=24000
PROXY_MAX_REQUEST_CHARS=200000
PROXY_COMPACTED_TOOL_RESULT_CHARS=4000
